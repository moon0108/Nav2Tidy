<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>tidybot_sim</name>
  <version>0.1.0</version>
  <description>Gazebo Fortress model and static world for the TidyBot++ holonomic base.</description>
  <maintainer email="munsanghun21115629@gmail.com">moon</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <!-- 임시 정의. 팀 원문 수령 시 같은 이름으로 교체된다. -->
  <exec_depend>athome_interfaces</exec_depend>

  <exec_depend>ros_gz_sim</exec_depend>
  <exec_depend>ros_gz_bridge</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>rviz2</exec_depend>
  <exec_depend>nav2_bringup</exec_depend>
  <exec_depend>teleop_twist_keyboard</exec_depend>

  <export><build_type>ament_cmake</build_type></export>
</package>
